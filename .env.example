# Copy to .env for local development. Never commit the real .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
ADMIN_URL=admin/

# Supabase Postgres. Use the pooler connection string (port 6543 = transaction
# pooler, 5432 = session pooler) and keep sslmode=require.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
CONN_MAX_AGE=60

# Dev only: store uploads on local disk instead of the bucket. Ignored in prod.
USE_LOCAL_STORAGE=0

# Supabase Storage S3 endpoint (Project Settings -> Storage -> S3 connection).
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_STORAGE_BUCKET_NAME=covers
AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_ADDRESSING_STYLE=path

# AI assistant (optional; the admin works without it)
OPENROUTER_API_KEY=
# Ordered fallback chain of free models (check openrouter.ai/models; free models change)
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# Used only by `manage.py seed_demo` to create the demo users
DEMO_ADMIN_PASSWORD=
DEMO_LIBRARIAN_PASSWORD=

MAX_ACTIVE_LOANS=5
